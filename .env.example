VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
# Optional: set true to use local auth/database emulators instead of cloud.
VITE_USE_FIREBASE_EMULATORS=false
# Leave blank to use the hostname of the frontend (also works from a phone).
VITE_FIREBASE_EMULATOR_HOST=
# Server-only Settings password; never prefix it with VITE_.
MUSIC_ADMIN_PASSWORD=
# Cloud Settings account email (password entered at runtime).
VITE_ADMIN_EMAIL=settings@music-room.app
# Optional Supabase PDF uploads for cloud builds. Public key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave unset to use the supplied songbook.
VITE_PDF_URL=/songbooks/songbook-2026-10.pdf
VITE_PDF_VERSION=2026-10
VITE_PDF_TITLE=חוברת שירים
