{
    "name": "music-room",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc && vite build",
        "preview": "vite preview --host 0.0.0.0",
        "check": "tsc --noEmit && tsc -p storage-worker/tsconfig.json",
        "storage:dev": "wrangler dev --config storage-worker/wrangler.jsonc",
        "storage:deploy": "wrangler deploy --config storage-worker/wrangler.jsonc",
        "test": "vitest run",
        "test:integration": "node scripts/test-local-suite.mjs",
        "emulators": "firebase emulators:start --only auth,database --project demo-music-room",
        "build:deploy": "tsc && vite build --mode deployment"
    },
    "dependencies": {
        "firebase": "^12.0.0",
        "pdfjs-dist": "^5.4.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261016.1",
        "@types/qrcode": "^1.5.5",
        "esbuild": "^0.28.2",
        "miniflare": "^5.20261012.0-beta",
        "typescript": "^5.9.0",
        "vite": "^7.1.0",
        "vitest": "^3.2.0",
        "wrangler": "^4.151.0"
    }
}
