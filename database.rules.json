{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": false,
      ".write": false
    },
    "syncDiagnostics": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
        "$uid": {
          "$session": {
            ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()) || (auth != null && auth.uid === $uid && $code.matches(/^[0-9]{6}$/) && $session.matches(/^[a-f0-9]{32}$/) && root.child('rooms').child($code).child('expiresAt').val() > now && newData.exists() && newData.child('roomCreatedAt').val() === root.child('rooms').child($code).child('createdAt').val())",
            ".validate": "newData.hasChildren(['roomCreatedAt','createdAt','updatedAt','expiresAt','batch','platform','browser','events']) && newData.child('batch').isNumber() && newData.child('batch').val() >= 1 && newData.child('batch').val() <= 120 && ((!data.exists() && newData.child('batch').val() === 1) || (data.exists() && newData.child('batch').val() === data.child('batch').val() + 1)) && newData.child('updatedAt').val() >= now - 60000 && newData.child('updatedAt').val() <= now + 60000 && (!data.exists() || newData.child('updatedAt').val() >= data.child('updatedAt').val() + 4000) && newData.child('expiresAt').val() > now",
            "roomCreatedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= now - 600000 && newData.val() <= now + 60000) || (data.exists() && newData.val() === data.val()))"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000 && newData.val() >= newData.parent().child('createdAt').val() && (!data.exists() || newData.val() >= data.val() + 4000)"
            },
            "expiresAt": {
              ".validate": "newData.isNumber() && newData.val() === newData.parent().child('createdAt').val() + 86400000 && newData.val() > now"
            },
            "batch": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 120 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
            },
            "platform": {
              ".validate": "newData.isString() && newData.val().matches(/^(ios|android|other)$/) && (!data.exists() || newData.val() === data.val())"
            },
            "browser": {
              ".validate": "newData.isString() && newData.val().matches(/^(safari|chrome|other)$/) && (!data.exists() || newData.val() === data.val())"
            },
            "events": {
              ".validate": "newData.hasChild('0')",
              "$index": {
                ".validate": "$index.matches(/^([0-9]|[1-4][0-9])$/) && newData.hasChildren(['event','at'])",
                "event": {
                  ".validate": "newData.isString() && newData.val().matches(/^(session-start|pinch-start|pinch-final|pinch-settled|remote-deferred|position-write-failed|pinch-layout|pinch-frame)$/)"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "page": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10000"
                },
                "zoom": {
                  ".validate": "newData.isNumber() && newData.val() >= 0.75 && newData.val() <= 4"
                },
                "sequence": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "reason": {
                  ".validate": "newData.isString() && newData.val().matches(/^(saved|not-saved|maxretry|write-failed)$/)"
                },
                "geometry": {
                  ".validate": "newData.hasChildren(['anchorPage','anchorOffset','anchorTop','anchorHeight','beforeTop','targetTop','actualTop','targetLeft','actualLeft','scrollHeight','viewportHeight']) && newData.parent().child('event').val().matches(/^(pinch-layout|pinch-frame)$/)",
                  "anchorPage": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10000" },
                  "anchorOffset": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                  "anchorTop": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
                  "anchorHeight": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000" },
                  "scrollHeight": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
                  "viewportHeight": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
                  "$metric": { ".validate": "$metric.matches(/^(beforeTop|targetTop|actualTop|targetLeft|actualLeft)$/) && newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000" }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "storageConfig": {
      ".read": "auth != null",
      "githubOrigin": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[A-Za-z0-9.-]+$/)"
      },
      "$other": { ".validate": false }
    },
    "songbook": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.exists()",
      ".validate": "newData.hasChildren(['pdfUrl','pdfVersion','pdfTitle'])",
      "pdfUrl": {
        ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val().beginsWith('https://') || (newData.val().beginsWith('/') && !newData.val().beginsWith('//')))"
      },
      "pdfVersion": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
      },
      "pdfTitle": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
      },
      "$other": {
        ".validate": false
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()",
      "$code": {
        ".read": "auth != null && $code.matches(/^[0-9]{6}$/) && (!data.exists() || data.child('expiresAt').val() > now)",
        ".write": "auth != null && $code.matches(/^[0-9]{6}$/) && ((!data.exists() && newData.child('masterId').val() === auth.uid) || (root.child('admins').child(auth.uid).val() === true && !newData.exists()))",
        ".validate": "newData.hasChildren(['masterId','createdAt','expiresAt','pdfUrl','pdfVersion','pdfTitle','position']) && ((newData.child('sheet').exists() && newData.child('position/sourceId').val() === newData.child('sheet/id').val()) || (!newData.child('sheet').exists() && (!newData.child('position/sourceId').exists() || newData.child('position/sourceId').val() === 'pdf')))",
        "masterId": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= now - 60000 && newData.val() <= now + 60000) || newData.val() === data.val())"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === newData.parent().child('createdAt').val() + 86400000) || newData.val() === data.val())"
        },
        "pdfUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048 && (!data.exists() || newData.val() === data.val())"
        },
        "pdfVersion": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
        },
        "pdfTitle": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200 && (!data.exists() || newData.val() === data.val())"
        },
        "position": {
          ".write": "auth != null && (data.parent().child('masterId').val() === auth.uid || data.parent().child('controllers').child(auth.uid).val() === true) && data.parent().child('expiresAt').val() > now && newData.exists()",
          ".validate": "newData.hasChildren(['page','offset','zoom','sequence','updatedAt']) && ((newData.parent().child('sheet').exists() && newData.child('sourceId').val() === newData.parent().child('sheet/id').val()) || (!newData.parent().child('sheet').exists() && (!newData.child('sourceId').exists() || newData.child('sourceId').val() === 'pdf')))",
          "writerId": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "sourceId": {
            ".validate": "newData.isString() && (newData.val() === 'pdf' || newData.val().matches(/^[a-f0-9]{32}$/))"
          },
          "page": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000 && newData.val() % 1 === 0"
          },
          "offset": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "zoom": {
            ".validate": "newData.isNumber() && newData.val() >= 0.75 && newData.val() <= 4"
          },
          "horizontal": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "sequence": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && ((!data.exists() && newData.val() === 0) || newData.val() > data.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        "sheet": {
          ".write": "auth != null && (data.parent().child('masterId').val() === auth.uid || data.parent().child('controllers').child(auth.uid).val() === true) && data.parent().child('expiresAt').val() > now",
          ".validate": "newData.hasChildren(['id','title']) && ((newData.hasChild('segments') && !newData.hasChild('pdfUrl')) || (newData.hasChild('pdfUrl') && !newData.hasChild('segments'))) && newData.parent().child('position/sourceId').val() === newData.child('id').val() && root.child('songs').child(newData.child('id').val()).exists() && !root.child('songs').child(newData.child('id').val()).child('deletedAt').exists()",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "segments": {
            ".validate": "newData.hasChild('0')",
            "$index": {
              ".validate": "$index.matches(/^([0-9]|[1-3][0-9])$/) && newData.hasChildren(['url','width','height'])",
              "url": {
                ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val().beginsWith('https://') || (newData.val().beginsWith('/') && !newData.val().beginsWith('//')))"
              },
              "width": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1600"
              },
              "height": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 2048"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          },
          "pdfUrl": {
            ".validate": "newData.isString() && newData.val() === root.child('songs').child(newData.parent().child('id').val()).child('pdfUrl').val()"
          },
          "fileNames": {
            ".validate": "newData.hasChild('0')",
            "$index": {
              ".validate": "$index.matches(/^([0-9]|1[0-9])$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 255"
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "controllers": {
          "$uid": {
            ".write": "auth != null && data.parent().parent().child('expiresAt').val() > now && ((root.child('admins').child(auth.uid).val() === true) || (data.parent().parent().child('masterId').val() === auth.uid && (!newData.exists() || data.parent().parent().child('controlRequests').child($uid).val() === true)) || (auth.uid === $uid && !newData.exists()))",
            ".validate": "newData.val() === true && $uid.matches(/^[A-Za-z0-9_-]{1,128}$/) && data.parent().parent().child('masterId').exists()"
          }
        },
        "controlRequests": {
          "$uid": {
            ".write": "auth != null && data.parent().parent().child('expiresAt').val() > now && (auth.uid === $uid || ((data.parent().parent().child('masterId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true) && !newData.exists()))",
            ".validate": "newData.val() === true && $uid.matches(/^[A-Za-z0-9_-]{1,128}$/) && data.parent().parent().child('masterId').exists()"
          }
        }
      }
    },
    "songs": {
      ".read": "auth != null",
      "$id": {
        ".write": "(auth != null && ((root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.exists() && newData.child('ownerId').val() === auth.uid && newData.child('roomCode').isString() && root.child('rooms').child(newData.child('roomCode').val()).child('expiresAt').val() > now && newData.child('createdAt').val() >= root.child('rooms').child(newData.child('roomCode').val()).child('createdAt').val()))) && (newData.parent().parent().child('defaultFile').val() !== $id || (newData.exists() && !newData.child('deletedAt').exists()))",
        ".validate": "$id.matches(/^[a-f0-9]{32}$/) && newData.hasChildren(['id','title','ownerId','createdAt']) && ((newData.hasChild('segments') && !newData.hasChild('pdfUrl')) || (newData.hasChild('pdfUrl') && !newData.hasChild('segments'))) && newData.child('id').val() === $id",
        "id": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "segments": {
          ".validate": "newData.hasChild('0')",
          "$index": {
            ".validate": "$index.matches(/^([0-9]|[1-3][0-9])$/) && newData.hasChildren(['url','width','height'])",
            "url": {
              ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val().beginsWith('https://vsnrxzpigrrafdrmjugo.supabase.co/storage/v1/object/public/room-sheets/' + newData.parent().parent().parent().child('ownerId').val() + '/' + $id + '/') || (root.child('storageConfig/githubOrigin').isString() && newData.val().beginsWith(root.child('storageConfig/githubOrigin').val() + '/files/' + newData.parent().parent().parent().child('ownerId').val() + '/' + $id + '/') && newData.val().matches(/^https:\\/\\/[A-Za-z0-9.-]+\\/files\\/[A-Za-z0-9_-]+\\/[a-f0-9]{32}\\/[0-9]+-([0-9]|[1-3][0-9])\\.jpg$/)))"
            },
            "width": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1600"
            },
            "height": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 2048"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "ownerId": {
          ".validate": "newData.isString() && newData.val().length <= 128 && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/) && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= now - 60000 && newData.val() <= now + 60000) || newData.val() === data.val())"
        },
        "deletedAt": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
        },
        "pdfUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.val() === 'https://vsnrxzpigrrafdrmjugo.supabase.co/storage/v1/object/public/room-pdfs/' + newData.parent().child('ownerId').val() + '/' + $id + '/document.pdf' || (root.child('storageConfig/githubOrigin').isString() && newData.val().beginsWith(root.child('storageConfig/githubOrigin').val() + '/files/' + newData.parent().child('ownerId').val() + '/' + $id + '/') && newData.val().matches(/^https:\\/\\/[A-Za-z0-9.-]+\\/files\\/[A-Za-z0-9_-]+\\/[a-f0-9]{32}\\/[0-9]+-document\\.pdf$/)))"
        },
        "fileNames": {
          ".validate": "newData.hasChild('0')",
          "$index": {
            ".validate": "$index.matches(/^([0-9]|1[0-9])$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 255"
          }
        }
      }
    },
    "defaultFile": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.exists()",
      ".validate": "newData.isString() && (newData.val() === 'pdf' || (newData.val().matches(/^[a-f0-9]{32}$/) && newData.parent().child('songs').child(newData.val()).exists() && !newData.parent().child('songs').child(newData.val()).child('deletedAt').exists()))"
    }
  }
}
